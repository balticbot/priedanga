{
  "name": "@priedanga/relay",
  "version": "0.1.0",
  "description": "Relays official PAGD warning messages as signed Priedanga alerts",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "relay": "tsx src/cli.ts"
  },
  "dependencies": {
    "@priedanga/alert-format": "*",
    "@priedanga/content-builder": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
