{
  "name": "@priedanga/tiltas",
  "version": "0.1.0",
  "description": "Tiltas: Bluetooth LE mesh protocol for relaying signed Priedanga alerts (reference implementation, simulation, test vectors)",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-vectors/*.json": "./test-vectors/*.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "vectors": "tsx scripts/gen-vectors.ts",
    "offers": "tsx scripts/offers.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@priedanga/alert-format": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
