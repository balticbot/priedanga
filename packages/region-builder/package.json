{
  "name": "@priedanga/region-builder",
  "version": "0.1.0",
  "description": "Builds offline region packs: map tiles (PMTiles) and a walking network",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "region": "tsx src/cli.ts"
  },
  "dependencies": {
    "@priedanga/alert-format": "*",
    "pmtiles": "4.5.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
