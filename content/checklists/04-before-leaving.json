  "items": [
    {
      "id": "gas-water-power",
      "text": {
        "lt": "Užsukti dujų ir vandens čiaupus, išjungti elektrą",
        "en": "Shut off gas and water, switch off the electricity",
        "ru": "Перекрыть газ и воду, отключить электричество",
        "pl": "Zakręcić gaz i wodę, wyłączyć prąd",
        "uk": "Перекрити газ і воду, вимкнути електрику"
      }
    },
    {
      "id": "windows-doors",
      "text": {
        "lt": "Uždaryti langus ir užrakinti duris",
        "en": "Close the windows and lock the doors",
        "ru": "Закрыть окна и запереть двери",
        "pl": "Zamknąć okna i drzwi na klucz",
        "uk": "Зачинити вікна й замкнути двері"
      }
    },
    {
