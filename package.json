{
  "name": "priedanga",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:packages": "npm run build -w @priedanga/alert-format -w @priedanga/content-builder",
    "pack": "npm run pack -w @priedanga/content-builder"
  },
  "engines": {
    "node": ">=22"
  }
}
